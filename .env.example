# Deye Cloud API (рівень заряду батареї)
# Отримайте токен на https://eu1-developer.deyecloud.com
# Токен БЕЗ префіксу VITE_ — не потрапляє в браузер, використовується тільки сервером (nginx / Vite proxy)
DEYE_TOKEN=your_bearer_token_here
VITE_DEYE_STATION_ID=61180551

# Scenario publishing PIN (used in Vite dev server for PUT auth)
# In production, this is handled by nginx htpasswd — see nginx-scenario.conf
SCENARIO_PIN=1234
